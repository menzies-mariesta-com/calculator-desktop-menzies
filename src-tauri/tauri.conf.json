{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Calculator",
	"version": "0.1.0",
	"identifier": "com.mariesta.menzies.calculator-desktop-menzies",
	"build": {
		"frontendDist": "../build",
		"devUrl": "http://localhost:2001",
		"beforeDevCommand": "npm run dev",
		"beforeBuildCommand": "npm run build"
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "Calculator",
				"width": 720,
				"height": 640,
				"minWidth": 360,
				"minHeight": 520,
				"resizable": true,
				"fullscreen": false,
				"decorations": false,
				"center": true
			}
		],
		"security": {
			"csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:2001 http://localhost:2001; worker-src 'self' blob:"
		}
	},
	"bundle": {
		"active": true,
		"createUpdaterArtifacts": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	},
	"plugins": {
		"updater": {
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ4Nzc0MTMzRjc1RjA5MjMKUldRakNWLzNNMEYzU0JEUTdHa1NXTkIza3RwRWxhQmhaNE4xdTZqeUcremhVb2JBaHk0TyszNzcK",
			"endpoints": ["https://github.com/menzies-mariesta-com/calculator-desktop-menzies/releases/latest/download/latest.json"]
		}
	}
}
