# Public Vite env (prefix VITE_). No secrets here.
# Desktop apps load config from the Menzies config dir, not from .env in production.

# Dev server port (must match Tauri devUrl). Default 2001.
VITE_DEV_PORT=2001

# --- Tauri updater (GitHub Releases) ---
# Replace OWNER/REPO in src-tauri/tauri.conf.json:
#   plugins.updater.endpoints[0] =
#   https://github.com/OWNER/REPO/releases/latest/download/latest.json
#
# Paste the public key contents (not a file path) into:
#   plugins.updater.pubkey
# Generate keys (do not commit the private key):
#   npm run tauri signer generate -- -w ~/.tauri/calculator-desktop-menzies.key
#
# Build/signing only (set in CI or your shell; never commit):
# TAURI_SIGNING_PRIVATE_KEY=<path-or-contents-of-private-key>
# TAURI_SIGNING_PRIVATE_KEY_PASSWORD=<optional-password>
